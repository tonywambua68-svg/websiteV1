# ============================================================================
# Product API server — environment (server-side ONLY).
# Copy to `server/.env.local` (gitignored) and fill in. NEVER commit real keys.
# None of these values ever reach the React frontend bundle.
# ============================================================================

# REQUIRED for POST/PUT/PATCH/DELETE. Keep it long and random.
# If omitted, a random key is generated and printed to the console at boot.
PRODUCTS_API_KEY=change-me-to-a-long-random-secret

# Optional — which origin may call the API from a browser (the scraper runs
# server-side, so it isn't bound by CORS; this is a convenience).
CORS_ORIGIN=http://localhost:4100

# Optional — override the JSON database location.
# PRODUCTS_DB=./server/data/products.json

# Optional — port for the combined website+API server (default 3000).
# PORT=3000
