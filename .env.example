# ============================================================================
#  Copy this file to `.env` for local development only.
#  NEVER commit `.env` to Git — it is protected by .gitignore.
#  Leave these empty (or delete .env) for production/template builds:
#  the store will then use the first-run setup page (/setup) to create
#  the administrator account interactively. No credentials are shipped.
# ============================================================================
VITE_DEMO_ADMIN_NAME=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_ADMIN_PHONE=

# ============================================================================
#  Product API — frontend addresses (NOT secrets, safe to commit).
#  Dev default: the storefront auto-resolves the API as
#  http://<same-hostname>:3000/api  (the API runs via: node server.mjs)
#  Set these only if your API lives somewhere else.
# ============================================================================
VITE_PRODUCTS_API_URL=
VITE_PRODUCTS_API_PORT=3000
