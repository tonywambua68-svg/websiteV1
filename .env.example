# OREMITECH E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your values.
# NEVER commit .env or secrets to git.

# -----------------------------------------------------------------------------
# Supabase Configuration (Central Relational Database & Auth)
# -----------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API
# ⚠️ DO NOT use placeholder or fake credentials — login will fail ("Invalid login credentials").
VITE_SUPABASE_URL=https://your-project.supabase.co
# Anon public key ONLY. Never put service_role key in frontend!
# Format starts with eyJ... (JWT), NOT sb_publishable_ or sb_secret_.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public site URL (used for password reset redirect links)
VITE_SITE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Business & Store Identity
# -----------------------------------------------------------------------------
VITE_SITE_NAME=OREMITECH
VITE_SITE_TAGLINE=Verified laptops and computer accessories in Kenya
VITE_CURRENCY=KES
VITE_TIMEZONE=Africa/Nairobi
VITE_LOCALE=en-KE

# -----------------------------------------------------------------------------
# Contact & Support (Optional customer support channels)
# -----------------------------------------------------------------------------
VITE_WHATSAPP_NUMBER=
VITE_STORE_EMAIL=
VITE_STORE_LOCATION=

# -----------------------------------------------------------------------------
# Analytics & Search Console (Optional)
# -----------------------------------------------------------------------------
VITE_GA_MEASUREMENT_ID=
VITE_GSC_VERIFICATION=

# -----------------------------------------------------------------------------
# M-PESA PayBill Configuration (manual payment)
# -----------------------------------------------------------------------------
# PayBill business number and account reference for customer payments
# Set only to the verified OREMITECH PayBill. Leave blank until confirmed.
VITE_MPESA_PAYBILL_NUMBER=
VITE_MPESA_PAYBILL_ACCOUNT=OREMITECH

# -----------------------------------------------------------------------------
# Maintenance Mode
# -----------------------------------------------------------------------------
# Set to "true" to show the maintenance page instead of normal routes.
# Controlled at build time per environment (staging vs production).
# Staging: VITE_SITE_MAINTENANCE_MODE=true
# Production: VITE_SITE_MAINTENANCE_MODE=false
VITE_SITE_MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# Cloudflare Pages Functions (server-side only — NOT exposed to the browser)
# -----------------------------------------------------------------------------
# Required by functions/sitemap.xml.js to list published articles and products.
# Configure these in Cloudflare Pages -> Settings -> Environment variables
# (Production and Preview). The VITE_ variants above are used as fallbacks.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Public origin used in sitemap <loc> values (defaults to https://oremitech.co.ke)
# SITE_URL=https://oremitech.co.ke
