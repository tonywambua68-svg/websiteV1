# Database Configuration
DATABASE_URL=mongodb://localhost:27017/imara-tech
# or for PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/imara_tech_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3000
NODE_ENV=development

# API Keys (if needed)
PRODUCTS_API_KEY=your-secret-key
STRIPE_SECRET_KEY=sk_test_your_stripe_key
SMTP_PASSWORD=your-smtp-password

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
VITE_ENABLE_ANALYTICS=true
VITE_MAINTENANCE_MODE=false

# Site Configuration
VITE_SITE_NAME=Imara Tech
VITE_SITE_TAGLINE=Quality Electronics
VITE_CURRENCY=USD
VITE_LOCALE=en-US

# Social Media (optional)
VITE_FACEBOOK_URL=
VITE_TWITTER_URL=
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
